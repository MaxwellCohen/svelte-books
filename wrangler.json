{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "svelte-books-optimized",
	"main": ".svelte-kit/cloudflare/worker/index.js",
	"build": {
		"command": "CLOUDFLARE=1 pnpm exec vite build"
	},
	"no_bundle": true,
	"rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
	"compatibility_date": "2026-09-15",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "CATALOG_CACHE",
			"id": "aec2e5bb49284fbdbbfdc00b27d0f935"
		}
	]
}
